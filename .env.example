APP_ENV=local
APP_NAME=CityFix

DB_HOST=localhost
DB_USER=root
DB_PASS=
DB_NAME=cityfix_db

# Genera uno largo y aleatorio: php -r "echo bin2hex(random_bytes(32));"
JWT_SECRET=
JWT_EXPIRY=900
JWT_REFRESH_EXPIRY=604800

MAX_LOGIN_ATTEMPTS=5
LOCKOUT_MINUTES=15

# Pon 1 solo si el servidor esta detras de un proxy (Railway) para leer la IP real
TRUST_PROXY=0

# Cloudinary (cloudinary.com > Dashboard > API Keys)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=cityfix
